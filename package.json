{
  "name": "acd-kit",
  "version": "0.1.6",
  "description": "Agentic Continuous Delivery kit: deterministic orchestrator, typed stages, pluggable harnesses",
  "type": "module",
  "bin": {
    "acd-kit": "./bin/acd.js",
    "acd": "./bin/acd.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "acd",
    "docs",
    "web/app",
    "web/lib",
    "web/proxy.ts",
    "web/next.config.ts",
    "web/next-env.d.ts",
    "web/package.json",
    "web/tsconfig.json",
    "acd.config.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "acd": "node ./bin/acd.js",
    "ui": "node ./bin/acd.js ui",
    "lint": "tsc -p tsconfig.json --noEmit",
    "write-schemas": "tsx scripts/write-schemas.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.32",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "next": "^16.3.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timothywisdom/agentic-continuous-delivery.git"
  },
  "homepage": "https://github.com/timothywisdom/agentic-continuous-delivery#readme",
  "bugs": {
    "url": "https://github.com/timothywisdom/agentic-continuous-delivery/issues"
  }
}
