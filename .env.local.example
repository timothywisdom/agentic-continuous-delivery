# =============================================================================
# .env.local.example → copy to .env.local (gitignored)
# =============================================================================
#
# API keys and other secrets live here — never in acd.config*.yaml.
# `acd` loads .env.local from the repo root automatically (does not override
# variables already set in your shell). Lines may use KEY=value or export KEY=value.
#
# Required only for the harness / classifier you actually use:
# =============================================================================

# Cursor Pro SDK (harnesses.cursor → driver: cursor-sdk)
CURSOR_API_KEY=

# Anthropic Messages API (harnesses.anthropic → driver: anthropic-api)
ANTHROPIC_API_KEY=

# Jev-class HTTP classifier (classifiers.jev → driver: classifier-api)
# Pair with classifiers.jev.baseUrl in YAML (non-secret URL stays in config).
CLASSIFIER_API_KEY=

# Optional: override classifiers.jev.baseUrl for this machine / CI
# CLASSIFIER_BASE_URL=https://your-classifier.example.com
