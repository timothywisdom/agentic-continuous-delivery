{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FixOutput",
  "type": "object",
  "properties": {
    "workId": {
      "type": "string"
    },
    "pipelineStatus": {
      "type": "string",
      "enum": [
        "green",
        "red"
      ]
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "workId",
    "pipelineStatus",
    "summary"
  ],
  "additionalProperties": false
}
