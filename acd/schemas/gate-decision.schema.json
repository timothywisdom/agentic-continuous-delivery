{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateDecision",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "uncertain"
      ]
    },
    "reason": {
      "type": "string"
    },
    "escalated": {
      "type": "boolean"
    }
  },
  "required": [
    "decision",
    "reason"
  ],
  "additionalProperties": false
}
