{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AcdConfig",
  "type": "object",
  "properties": {
    "defaults": {
      "type": "object",
      "properties": {
        "harness": {
          "type": "string"
        },
        "hitl": {
          "type": "string",
          "enum": [
            "all",
            "none",
            "custom"
          ]
        },
        "max_repair_loops": {
          "type": "number"
        }
      },
      "required": [
        "harness"
      ],
      "additionalProperties": false
    },
    "stages": {
      "type": "object",
      "additionalProperties": true
    },
    "agents": {
      "type": "object",
      "additionalProperties": true
    },
    "harnesses": {
      "type": "object",
      "additionalProperties": true
    },
    "classifiers": {
      "type": "object",
      "additionalProperties": true
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "otlpEndpoint": {
          "type": "string"
        },
        "serviceName": {
          "type": "string"
        },
        "pricing": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "repo": {
      "type": "object",
      "properties": {
        "testCommand": {
          "type": "string"
        },
        "lintCommand": {
          "type": "string"
        },
        "typecheckCommand": {
          "type": "string"
        },
        "secretScanCommand": {
          "type": "string"
        },
        "blockImplementerMerge": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "defaults",
    "harnesses"
  ],
  "additionalProperties": false
}
