{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkState",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "currentStage": {
      "type": "string",
      "enum": [
        "intake",
        "specify",
        "implement",
        "review",
        "pr",
        "ci_review",
        "fix",
        "deploy",
        "canary",
        "rollback",
        "hypothesis"
      ]
    },
    "completedStages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "intake",
          "specify",
          "implement",
          "review",
          "pr",
          "ci_review",
          "fix",
          "deploy",
          "canary",
          "rollback",
          "hypothesis"
        ]
      }
    },
    "pipelineStatus": {
      "type": "string",
      "enum": [
        "green",
        "red"
      ]
    },
    "awaitingApproval": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "intake",
            "specify",
            "implement",
            "review",
            "pr",
            "ci_review",
            "fix",
            "deploy",
            "canary",
            "rollback",
            "hypothesis"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "awaitingGuidance": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "intake",
            "specify",
            "implement",
            "review",
            "pr",
            "ci_review",
            "fix",
            "deploy",
            "canary",
            "rollback",
            "hypothesis"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "guidanceNote": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "currentScenario": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "implementQueue": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "number"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "new",
                  "fidelity",
                  "fix",
                  "cleanup",
                  "harness"
                ]
              },
              "brief": {
                "type": "string"
              },
              "file": {
                "type": "string"
              }
            },
            "required": [
              "index",
              "mode",
              "brief"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "absorbedReviewFindings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baseSha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewSha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptanceHarnessReady": {
      "type": "boolean"
    },
    "waivedFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "false-positive",
              "accepted-risk",
              "out-of-scope",
              "mitigated",
              "duplicate"
            ]
          },
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "actor": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "line": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "reason",
          "explanation",
          "actor",
          "at",
          "file",
          "issue",
          "agent",
          "line"
        ],
        "additionalProperties": false
      }
    },
    "lastError": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastStageOutput": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "approvedStages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "intake",
          "specify",
          "implement",
          "review",
          "pr",
          "ci_review",
          "fix",
          "deploy",
          "canary",
          "rollback",
          "hypothesis"
        ]
      }
    },
    "rejectedStages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "intake",
              "specify",
              "implement",
              "review",
              "pr",
              "ci_review",
              "fix",
              "deploy",
              "canary",
              "rollback",
              "hypothesis"
            ]
          },
          "reason": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        },
        "required": [
          "stage",
          "reason",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "sourceText": {
      "type": "string"
    },
    "implementerIdentity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "createdAt",
    "updatedAt",
    "currentStage",
    "completedStages",
    "pipelineStatus",
    "awaitingApproval",
    "currentScenario",
    "lastError",
    "lastStageOutput",
    "approvedStages",
    "rejectedStages",
    "sourceText",
    "implementerIdentity"
  ],
  "additionalProperties": false
}
